      "parameters": {
        "jsCode": "const b = $input.first().json.body ?? {};\nconst errores = [];\nconst pedidos = ['order.created', 'payment.simulated', 'order.status_changed'];\nif (!b.evento_id) errores.push('falta evento_id');\nif (!b.tipo) errores.push('falta tipo');\nif (!b.cliente?.usuario_tienda_id) errores.push('falta cliente');\nif (pedidos.includes(b.tipo)) {\n  if (!b.pedido?.pedido_tienda_id) errores.push('falta pedido');\n  if (b.tipo !== 'order.status_changed' && !b.pedido?.lineas?.length) errores.push('pedido sin líneas');\n} else if (b.tipo === 'support.requested') {\n  if (!b.incidencia?.incidencia_tienda_id) errores.push('falta incidencia');\n} else {\n  errores.push('tipo no soportado: ' + b.tipo);\n}\nreturn [{ json: { valido: errores.length === 0, errores: errores.join('; '), evento: b } }];"
      },
